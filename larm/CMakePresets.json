{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "LARM_BUILD_TESTS": true,
        "LARM_WARNINGS_AS_ERRORS": true,
        "LARM_MUJOCO_ROOT": "${sourceDir}/../.deps/mujoco-3.8.0",
        "Python3_EXECUTABLE": "/usr/bin/python3",
        "PYTHON_EXECUTABLE": "/usr/bin/python3"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++"}
    },
    {
      "name": "asan",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tsan", "configurePreset": "tsan"}
  ],
  "testPresets": [
    {"name": "base", "hidden": true, "output": {"outputOnFailure": true}, "execution": {"timeout": 300}},
    {"name": "debug", "inherits": "base", "configurePreset": "debug"},
    {"name": "release", "inherits": "base", "configurePreset": "release"},
    {"name": "asan", "inherits": "base", "configurePreset": "asan"},
    {"name": "tsan", "inherits": "base", "configurePreset": "tsan"}
  ]
}
